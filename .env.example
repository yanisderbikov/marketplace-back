# marketplace-back — переменные окружения.
# Значений по умолчанию в application.properties нет: без любой из переменных приложение не стартует.
# Скопируйте в .env и заполните (.env в .gitignore).

# ── HTTP / фронт ──
# Origins фронта через запятую: CORS ответов Spring и CORS бакета S3 (если S3_CORS_AUTO=true).
# Сравниваются точно, вместе с портом: локально — порт dev-сервера marketplace-front (vite.config.js, server.port 3000)
ALLOWED_ORIGINS=http://localhost:3000
# Origin фронта без слэша на конце — для ссылок в письмах (тот же dev-сервер фронта)
FRONT_URL=http://localhost:3000

# ── PostgreSQL ──
POSTGRES_URL=jdbc:postgresql://localhost:5432/marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me

# ── S3 (Yandex Object Storage): фото товаров, логотипы и обложки магазинов ──
S3_BUCKET_NAME=marketplace-media
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# true — при старте прописать CORS бакета из ALLOWED_ORIGINS (нужно для загрузки из браузера); false — правила вручную
S3_CORS_AUTO=true

# ── Вход мерчантов ──
# Ключ подписи JWT (HS256), минимум 32 символа: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Срок жизни токена в секундах (30 дней = 2592000)
JWT_EXPIRATION_SECONDS=2592000
# Почты супер-админов платформы через запятую (включают/выключают магазины), минимум одна
ADMIN_SUPER_EMAILS=owner@example.com
# Ключ HMAC-SHA256 для хранения кодов входа (в БД только хэш кода): openssl rand -base64 32
AUTH_LOGIN_CODE_SECRET=change-me

# ── Email (NotiSend): коды входа и письма о заказах ──
EMAIL_NOTISEND_API_KEY=change-me
# Адрес отправителя (домен должен быть подтверждён в NotiSend)
EMAIL_NOTISEND_EMAIL_ADDRESS=noreply@example.com
# Имя отправителя в письмах
EMAIL_NOTISEND_FROM_NAME=marketplace

# ── СДЭК ── ключей платформы нет: каждый мерчант подключает свой аккаунт СДЭК в админке
# (Account и Secure password), расчёт доставки и справочник ПВЗ идут по ключам магазинов.
# Код тарифа для расчёта доставки «склад–склад» (например 136 — посылка склад-склад)
SDEK_TARIFF_CODE=136

# ── Оплата: у каждого магазина свой терминал Т-Банка (TerminalKey и пароль мерчант вводит в админке) ──
# Адрес API Т-Банка (боевой: https://securepay.tinkoff.ru/v2)
PAYMENT_TINKOFF_API_URL=https://securepay.tinkoff.ru/v2
# Публичный URL вебхука бэкенда — передаётся в Init каждого платежа
PAYMENT_TINKOFF_NOTIFICATION_URL=https://api.example.com/api/public/payment/tinkoff-webhook
# Ключ AES-256 для шифрования паролей терминалов в БД: base64 ровно от 32 байт (openssl rand -base64 32).
# Сменить ключ = потерять все сохранённые пароли терминалов
PAYMENT_SECRETS_KEY=change-me-base64-of-32-bytes
# Хосты, на которые разрешено вернуть покупателя после оплаты (returnUrl), через запятую
PAYMENT_ALLOWED_RETURN_HOSTS=localhost,example.com
# Как часто поллер спрашивает у Т-Банка статус неоплаченных заказов, мс
PAYMENT_PENDING_CHECK_INTERVAL_MS=60000

# ── Свои домены витрин ── мерчант вводит домен в кабинете, бэк подключает его к гейтвею
# и сразу отдаёт DNS-записи для регистратора.
# static — свой сервер: гейтвей (Caddy on-demand TLS) сам выпускает сертификаты, записи — из настроек ниже.
# railway — домен регистрируется на сервисе гейтвея через Railway API, записи (CNAME + TXT) выдаёт Railway.
DOMAIN_PROVISIONER=static
# static: куда мерчанту направить CNAME (хост с A-записью на сервер гейтвея)
DOMAIN_CNAME_TARGET=shops.example.com
# static: IP гейтвея для корневых доменов (A-запись); пусто — корневым тоже предлагается CNAME/ALIAS
DOMAIN_A_RECORD_IP=
# railway: токен проекта (Project Settings → Tokens) и его вид: project или account (Bearer)
RAILWAY_API_TOKEN=
RAILWAY_API_TOKEN_KIND=project
# railway: RAILWAY_PROJECT_ID и RAILWAY_ENVIRONMENT_ID Railway подставляет в каждый сервис сам;
# id сервиса гейтвея и порт, на который вести домены
RAILWAY_GATEWAY_SERVICE_ID=
RAILWAY_GATEWAY_PORT=8080
